# Footprinter environment variables
# Copy to .env and uncomment to override defaults.

# Base directory for all Footprinter data (config, database, vectors).
# Default: ~/.footprinter/
# FOOTPRINTER_HOME=~/.footprinter

# Path to the YAML configuration file.
# Default: $FOOTPRINTER_HOME/config.yaml
# FOOTPRINTER_CONFIG=

# Path to the SQLite database.
# Default: $FOOTPRINTER_HOME/footprinter.db
# FOOTPRINTER_DB_PATH=

# Python logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Default: INFO
# LOG_LEVEL=INFO
